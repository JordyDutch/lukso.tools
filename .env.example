NEXT_PUBLIC_LUKSO_CHAIN_ID=42
NEXT_PUBLIC_LUKSO_RPC_URL=https://rpc.mainnet.lukso.network
NEXT_PUBLIC_LUKSO_IPFS_GATEWAY=https://api.universalprofile.cloud/ipfs/

# Hashlists protocol collection. Defaults:
# LUKSO mainnet 42: 0xcD24F4b22729f3d531853255e1F31D87E42dD219
# LUKSO testnet 4201: 0xd5127cBcb66cCb18ff02d85FB461E4c284319023
NEXT_PUBLIC_HASHLISTS_PROTOCOL_ADDRESS=

# LSP7 LIKES token used for tool/list appreciation.
NEXT_PUBLIC_LIKES_TOKEN_ADDRESS=
NEXT_PUBLIC_DEFAULT_LIKES_AMOUNT=1

# Real HashLists/List UPs. Entries are matched by the static list id.
NEXT_PUBLIC_CURATED_LISTS='[{"id":"jordy-dev-essentials","hashListAddress":"0x0000000000000000000000000000000000000000","listUpAddress":"0x0000000000000000000000000000000000000000"}]'

# Real Tool UP addresses. Entries are matched by the static tool id.
NEXT_PUBLIC_TOOL_PROFILES='[{"toolId":"stakingverse","upAddress":"0x0000000000000000000000000000000000000000"}]'
